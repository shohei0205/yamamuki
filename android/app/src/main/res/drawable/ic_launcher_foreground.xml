<?xml version="1.0" encoding="utf-8"?>
<!--
  アプリアイコンの前景。方位盤の画面を縮めた形: 上に方位目盛りと赤い N、中央に緑の山、
  下に白い丸の現在地と、距離の同心円とその間の帯。地の色は ic_launcher_background。
  iOS の AppIcon(ios/Yamamuki/Assets.xcassets)も同じ図形から作っている。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 図形は 1024 四方(iOS の AppIcon と同じ座標)で描き、見える範囲(中央 72dp)に縮める。 -->
    <group
        android:scaleX="0.0703125"
        android:scaleY="0.0703125"
        android:translateX="18"
        android:translateY="18">
        <!-- 距離の帯(外から順に、近いほど濃い) -->
        <path
            android:fillColor="#FFFFF1CF"
            android:pathData="M17,810 a495,495 0 1,0 990,0 a495,495 0 1,0 -990,0Z" />
        <path
            android:fillColor="#FFFFEDC2"
            android:pathData="M182,810 a330,330 0 1,0 660,0 a330,330 0 1,0 -660,0Z" />
        <path
            android:fillColor="#FFFFE7B0"
            android:pathData="M347,810 a165,165 0 1,0 330,0 a165,165 0 1,0 -330,0Z" />
        <!-- 距離の同心円 -->
        <path
            android:pathData="M17,810 a495,495 0 1,0 990,0 a495,495 0 1,0 -990,0Z M182,810 a330,330 0 1,0 660,0 a330,330 0 1,0 -660,0Z M347,810 a165,165 0 1,0 330,0 a165,165 0 1,0 -330,0Z"
            android:strokeColor="#FFE8C98F"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="6" />
        <!-- 方位目盛り -->
        <path
            android:pathData="M259.7,300 V250.7 M343.8,300 V221.7 M427.9,300 V250.7 M596.1,300 V250.7 M680.2,300 V221.7 M764.3,300 V250.7"
            android:strokeColor="#FF2E3A40"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="17" />
        <!-- 北を示す N -->
        <path
            android:pathData="M474,296 V166 L550,296 V166"
            android:strokeColor="#FFED1C24"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="30" />
        <!-- 山。方位盤の 1000m 未満の山と同じ緑の丸い山に、影と白い縁と右の斜面の陰を付ける -->
        <path
            android:fillColor="#2E000000"
            android:pathData="M282,713.5 Q370.6,600.4 476.6,462.4 Q512,424.6 547.4,462.4 Q653.5,600.4 742,713.5Z" />
        <path
            android:pathData="M282,700 Q370.6,586.9 476.6,448.9 Q512,411.1 547.4,448.9 Q653.5,586.9 742,700Z"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="39" />
        <path
            android:fillColor="#FF3DBB5C"
            android:pathData="M282,700 Q370.6,586.9 476.6,448.9 Q512,411.1 547.4,448.9 Q653.5,586.9 742,700Z" />
        <path
            android:fillColor="#5923853B"
            android:pathData="M529.7,461.3 Q618.3,574.5 688.9,674.9 L565.1,674.9Z" />
        <!-- 現在地(白い丸の上の点) -->
        <path
            android:fillColor="#2E000000"
            android:pathData="M466,814 a46,46 0 1,0 92,0 a46,46 0 1,0 -92,0Z" />
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M466,810 a46,46 0 1,0 92,0 a46,46 0 1,0 -92,0Z" />
        <path
            android:fillColor="#FF2E3A40"
            android:pathData="M490,810 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0Z" />
    </group>
</vector>
