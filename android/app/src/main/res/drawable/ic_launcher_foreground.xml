<?xml version="1.0" encoding="utf-8"?>
<!--
  アプリアイコンの前景。方位盤の画面を縮めた形: 上に方位目盛りと赤い N、中央に山、
  下に現在地と距離の同心円。ランチャーの切り抜きで欠けないよう、中央 66dp に収まるよう縮める。
  iOS の AppIcon(ios/Yamamuki/Assets.xcassets)も同じ図形から作っている。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.8"
        android:scaleY="0.8">
        <!-- 距離の同心円 -->
        <path
            android:pathData="M40,84 A14,14 0 0 1 68,84 M28,84 A26,26 0 0 1 80,84"
            android:strokeColor="#FFC3C3C3"
            android:strokeWidth="1.6" />
        <!-- 方位目盛り -->
        <path
            android:pathData="M34,26v4M40,26v3M46,26v4M62,26v4M68,26v3M74,26v4"
            android:strokeColor="#FF222222"
            android:strokeLineCap="round"
            android:strokeWidth="1.2" />
        <!-- 北を示す N -->
        <path
            android:pathData="M50.5,32V22.5L57.5,32V22.5"
            android:strokeColor="#FFED1C24"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="2.4" />
        <!-- 山。方位盤の 1000m 台の山と同じく黄緑の ▲ を緑で縁取る(縁は画面と同じ比率の細さ)。 -->
        <path
            android:fillColor="#FFB5E61D"
            android:pathData="M54,43L70,70H38Z"
            android:strokeColor="#FF22B14C"
            android:strokeWidth="2.3" />
        <!-- 現在地 -->
        <path
            android:fillColor="#FF111111"
            android:pathData="M54,81m-3.2,0a3.2,3.2 0 1,0 6.4,0a3.2,3.2 0 1,0 -6.4,0" />
    </group>
</vector>
