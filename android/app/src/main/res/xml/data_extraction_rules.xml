<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 以降の自動バックアップの対象。backup_rules.xml と同じもの(山データのキャッシュと、それに対応する記録(山データの種類ごと・地表データ)と、初回起動の確認の記録)を外す。
  機種変更での端末間の移行では、事前ダウンロードした山データも引き継ぐので外さない。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="mountains.db" />
        <exclude domain="database" path="mountains.db-wal" />
        <exclude domain="database" path="mountains.db-shm" />
        <exclude domain="database" path="mountains.db-journal" />
        <exclude domain="sharedpref" path="saved_areas.xml" />
        <exclude domain="sharedpref" path="area_download_pending.xml" />
        <exclude domain="sharedpref" path="peak_data.xml" />
        <exclude domain="sharedpref" path="peak_data_gsi-peaks.xml" />
        <exclude domain="sharedpref" path="surface_data_esa-worldcover-z9.xml" />
        <exclude domain="sharedpref" path="surface_data_esa-worldcover-z10.xml" />
        <exclude domain="sharedpref" path="surface_data_esa-worldcover-z11.xml" />
        <exclude domain="sharedpref" path="surface_data_esa-worldcover-z12.xml" />
        <exclude domain="sharedpref" path="first_launch.xml" />
    </cloud-backup>
</data-extraction-rules>
