{
  "sourceLanguage": "ja",
  "strings": {
    "area_cancel": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中断"
          }
        }
      }
    },
    "area_confirm_download_title": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@をダウンロードしますか？"
          }
        }
      }
    },
    "area_confirm_message": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$ld 区画の山データを OpenStreetMap（Overpass API）から取得します。サーバーの混み具合によっては数分かかります。途中で中断でき、この画面を閉じてもダウンロードは継続します。アプリを終了すると一時停止しますが、次に開いた時に再開できます。"
          }
        }
      }
    },
    "area_confirm_refresh_title": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@を再取得しますか？"
          }
        }
      }
    },
    "area_delete_message": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した山データを削除します。ほかの保存済み地域と重複するデータは残ります。"
          }
        }
      }
    },
    "area_delete_title": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@を削除しますか？"
          }
        }
      }
    },
    "area_description": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電波が届く場所で、目的地周辺の山データを事前に保存できます。\n事前に保存した山データは、設定で山データを削除しても残ります。"
          }
        }
      }
    },
    "area_download": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード"
          }
        }
      }
    },
    "area_notice_canceled": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@のダウンロードを中断しました（%2$ld / %3$ld 区画保存済み）。"
          }
        }
      }
    },
    "area_notice_done": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@のダウンロードが完了しました（山 %2$@ 件）。"
          }
        }
      }
    },
    "area_notice_failed": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@の取得に失敗しました。サーバーの混雑または通信状況が原因の可能性があります。"
          }
        }
      }
    },
    "area_notice_failed_progress": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@の取得に失敗しました（%2$ld / %3$ld 区画保存済み）。サーバーの混雑または通信状況が原因の可能性があります。"
          }
        }
      }
    },
    "area_notice_pending": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@のダウンロードが中断されています。「ダウンロードを再開」で再開できます。"
