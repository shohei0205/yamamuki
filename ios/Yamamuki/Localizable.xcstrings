{
  "sourceLanguage": "ja",
  "strings": {
    "area_cancel": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中断"
          }
        }
      }
    },
    "area_confirm_download_title": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@をダウンロードしますか？"
          }
        }
      }
    },
    "area_confirm_message": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$ld 区画の山データを OpenStreetMap（Overpass API）から取得します。サーバーの混み具合によっては数分かかります。途中で中断でき、この画面を閉じてもダウンロードは継続します。アプリを終了すると一時停止しますが、次に開いた時に再開できます。"
          }
        }
      }
    },
    "area_confirm_refresh_title": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@を取り直しますか？"
          }
        }
      }
    },
    "area_delete_message": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した山データを端末から消します。ほかの保存済みの地域と重なる部分は残ります。"
          }
        }
      }
    },
    "area_delete_title": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@を削除しますか？"
          }
        }
      }
    },
    "area_description": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目的地周辺の山データを、電波の届く場所で事前に端末へ保存することができます。\n事前に保存した山データは、キャッシュを消去しても残ります。"
          }
        }
      }
    },
    "area_download": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード"
          }
        }
      }
    },
    "area_notice_canceled": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@のダウンロードを中断しました（%2$ld / %3$ld 区画まで保存済み）。"
          }
        }
      }
    },
    "area_notice_done": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@のダウンロードが完了しました（山 %2$@ 件）。"
          }
        }
      }
    },
    "area_notice_failed": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@のダウンロード中に通信に失敗しました。サーバーが混み合っているか、電波が弱い可能性があります。"
          }
        }
      }
    },
    "area_notice_failed_progress": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@のダウンロード中に通信に失敗しました（%2$ld / %3$ld 区画まで保存済み）。サーバーが混み合っているか、電波が弱い可能性があります。"
          }
        }
      }
    },
    "area_notice_pending": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@のダウンロードが途中で終わっています。「続きから再開」で残りを取得します。"
          }
        }
      }
    },
    "area_offline": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "圏外のため、今はダウンロードできません。電波の届く場所で開いてください。"
